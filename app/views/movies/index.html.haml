- content_for :title, "Movies"

%h1 Movies

%table#movies
  %thead
    %tr
      %th= link_to "Título", movies_path(sort: "title")
      %th Classificação
      %th= link_to "Lançamento", movies_path(sort: "release_date")
      %th Detalhes
  %tbody
    - @movies.each do |movie|
      %tr
        %td= movie.title
        %td= movie.rating
        %td= movie.release_date
        %td= link_to "Ver detalhes", movie_path(movie)



= link_to "New movie", new_movie_path
